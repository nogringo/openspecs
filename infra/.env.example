# Where the app listens on the host. Loopback by default, since the app serves
# plain HTTP and expects a reverse proxy in front of it.
OPENSPECS_BIND=127.0.0.1:3000

# The public address of this deployment, origin only, no path. Canonical URLs,
# OpenGraph tags and structured data are built from it, and the app cannot infer
# it: behind a proxy it only sees its own loopback address. Left empty, it falls
# back to the proxy's forwarded headers.
OPENSPECS_PUBLIC_URL=https://example.org

# Where the OpenGraph cards drawn for each document are kept between requests.
# Defaults to the system temporary directory, which is emptied on reboot: the
# cards are redrawn on demand, so nothing is lost but a few milliseconds.
# OPENSPECS_CACHE_DIR=/var/cache/openspecs

# The relays the crawler copies documents to, separated by commas. This is the
# one worth setting: a corpus copied by many operators is one none of them can
# decide to drop. The list replaces the built in one rather than adding to it,
# so keep whatever you still want written to. Empty means the built in list.
OPENSPECS_CRAWLER_MIRRORS=wss://relay.example.org

# The relays it reads documents from, separated by commas. Empty means the ones
# the web app queries, so the crawler sees what a reader sees.
OPENSPECS_CRAWLER_SOURCES=

# Set this and the crawler also archives: every revision it reads is preserved
# as a kind 1349 snapshot, so a document's history survives the edit that would
# otherwise erase it. Empty means it only copies documents, which needs no key.
#
# An nsec, or the same key in hex. It signs the snapshots and nothing else: what
# it proves is that this archivist saw a version, never who wrote it. Generate
# one for this and use it nowhere else. It is a secret, so a .env that carries
# it should be readable by nobody else.
OPENSPECS_CRAWLER_ARCHIVIST_KEY=

# Only used with the Caddy overlay: the domain Caddy serves and requests a
# certificate for. Use localhost for local runs.
OPENSPECS_DOMAIN=localhost
