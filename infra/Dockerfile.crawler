FROM dart:stable AS build
# ndk carries a Rust crate that its build hook compiles from source, so rustup
# and a linker have to be here even though nothing in this app is Rust.
RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential \
  && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
  | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH=/root/.cargo/bin:$PATH
WORKDIR /app
COPY apps/crawler/pubspec.yaml apps/crawler/pubspec.lock ./
RUN dart pub get
COPY apps/crawler/ ./
RUN dart pub get --offline
# `dart build` rather than `dart compile exe`: ndk pulls native code through
# build hooks, which only this one runs. It writes an executable next to the
# dynamic libraries it loads, so the bundle travels whole.
RUN dart build cli --output /build

# Debian rather than Alpine: the compiled executable is linked against glibc, so
# musl cannot run it.
FROM debian:stable-slim AS runtime
# Load bearing: relays are dialled over TLS and Dart reads the system trust
# store, so without this every connection times out.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN useradd --system --user-group --no-create-home --uid 65532 crawler
COPY --from=build /build/bundle/ /app/
# A fresh named volume inherits the ownership of the directory it covers, which
# is the only reason a crawler that is not root can write its state there.
RUN install -d -o crawler -g crawler /data
USER crawler
ENTRYPOINT ["/app/bin/crawler", "--data", "/data"]
